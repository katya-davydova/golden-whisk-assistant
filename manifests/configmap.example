apiVersion: v1
kind: ConfigMap
metadata:
  name: pinecone-configmap
data:
  MODEL_NAME: gpt-4
  EMBEDDING_MODEL_NAME: text-embedding-3-small
  PINECONE_INDEX_NAME: main-index


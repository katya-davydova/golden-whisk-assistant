apiVersion: v1
kind: Secret
metadata:
  name: auralisone-agent-secrets
type: Opaque
stringData:
  OPENAI_API_KEY: your-openai-key-here
  PINECONE_API_KEY: your-pinecone-key-here
  MODEL_NAME: your-pinecone-model-name
  EMBEDDING_MODEL_NAME: your-pinecone-embedding-model-name
  PINECONE_INDEX_NAME: your-pinecone-pinecone-index-name


# kubectl create secret generic auralisone-agent-secrets --from-env-file=.env
# kubectl get secret
# kubectl get secrets auralisone-agent-secrets -o yaml
# kubectl delete secrets auralisone-agent-secrets